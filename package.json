{
  "name": "subgraph-template-typescript-apollo-server",
  "private": true,
  "description": "A template for TypeScript projects with pre-configured tooling",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/apollographql/subgraph-template-typescript-apollo-server"
  },
  "homepage": "https://github.com/apollographql/subgraph-template-typescript-apollo-server#readme",
  "bugs": {
    "url": "https://github.com/apollographql/subgraph-template-typescript-apollo-server/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.0"
  },
  "scripts": {
    "build": "npm run codegen && tsc",
    "codegen": "graphql-codegen",
    "postinstall": "npm run build",
    "start": "node dist/index.js",
    "update-qa-metrics": "ts-node src/qa/update-readme-metrics.ts",
    "readme:update": "jest --forceExit --json --outputFile=.jest-results.json && jest tests/unit tests/integration --testPathIgnorePatterns=\"countries\" --forceExit --coverage --coverageReporters=json-summary && ts-node scripts/update-readme.ts",
    "schema:heal": "ts-node scripts/heal-compliance.ts",
    "dev": "nodemon --watch \"src/**\" --ext \"ts,json,graphql\" --exec \"npm run build && npm run start\" --ignore ./src/__generated__/ --ignore ./src/datasources/BarAPI.ts",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --testPathIgnorePatterns=\"countries\"",
    "test:contract": "jest tests/contract",
    "test:coverage": "jest tests/unit tests/integration --testPathIgnorePatterns=\"countries\" --coverage",
    "test:perf": "jest tests/performance --runInBand --testPathIgnorePatterns=\"countries\"",
    "test:spacex": "jest --testPathIgnorePatterns=\"countries\"",
    "test:countries": "jest --testPathPattern=\"countries\"",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@apollo/server": "^4.10.2",
    "@apollo/server-plugin-response-cache": "^4.1.3",
    "@apollo/subgraph": "^2.7.2",
    "dataloader": "^2.2.2",
    "graphql-depth-limit": "^1.1.0",
    "graphql-rate-limit": "^3.3.0",
    "graphql-tag": "latest",
    "graphql-validation-complexity": "^0.4.2",
    "lodash": "^4.17.21",
    "node-fetch": "^2.6.8"
  },
  "devDependencies": {
    "@apollo/graphql-testing-library": "^0.3.0",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@graphql-codegen/cli": "^2.6.2",
    "@graphql-codegen/typescript": "^2.4.11",
    "@graphql-codegen/typescript-resolvers": "^2.6.4",
    "@graphql-inspector/core": "^4.0.0",
    "@graphql-tools/mock": "^9.1.7",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/graphql-validation-complexity": "^0.4.4",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.191",
    "@types/node": "^18.7.23",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "autocannon": "^7.15.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.0.0",
    "graphql": "^16.13.2",
    "jest": "^29.7.0",
    "msw": "^2.14.2",
    "nodemon": "^2.0.15",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.3"
  }
}
